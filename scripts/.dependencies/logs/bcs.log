2026-08-31 18:56:39  INFO bcs_ws::bot::dispatcher: 📥 [BCS] 收到 Bot 事件 (解析失败) bot_id=谁是卧底主持人 event=agent payload=Some(Object {"bcs_group_id": String("bcs_grp_6634eeaef9384f60a8295974e495c2c6:a950cdc1"), "data": Object {"itemId": String("tool:fc-a3300148-86e4-419d-9fed-03b4e38af179"), "kind": String("tool"), "meta": String("from ~/Desktop/Avernet/.standalone-openclaw/workspaces/undercover-referee/skills/undercover-game-referee/references/boards.md"), "name": String("read"), "phase": String("start"), "startedAt": Number(1788173799436), "status": String("running"), "title": String("read from ~/Desktop/Avernet/.standalone-openclaw/workspaces/undercover-referee/skills/undercover-game-referee/references/boards.md"), "toolCallId": String("fc-a3300148-86e4-419d-9fed-03b4e38af179")}, "run_id": String("c75bd3dc-e15b-41d0-b62a-025daba98074"), "stream": String("item"), "ts": Number(1788173799437)})
