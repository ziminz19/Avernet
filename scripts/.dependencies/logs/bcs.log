        {
          "player": "逻辑控林工",
          "seat": 2,
          "text": "每次去都得提前好长时间出发"
        },
        {
          "player": "你",
          "seat": 3,
          "text": "每次都得等好久"
        },
        {
          "player": "稳健老陈",
          "seat": 4,
          "text": "进去之前总要先找地方停下"
        },
        {
          "player": "和事佬阿和",
          "seat": 5,
          "text": "人多的时候真的要预留好长时间"
        }
      ]
    },
    {
      "round": 3,
      "speeches": [
        {
          "player": "戏精阿浪",
          "seat": 1,
          "text": "说真的买了票就剩一件事干等"
        },
        {
          "player": "逻辑控林工",
          "seat": 2,
          "text": "进去之后先过一道安检，然后就在大厅等着叫号"
        },
        {
          "player": "你",
          "seat": 3,
          "text": "能快速的到很远的地方"
        },
        {
          "player": "稳健老陈",
          "seat": 4,
          "text": "拿着票找到对应的那条通道就行"
        },
        {
          "player": "和事佬阿和",
          "seat": 5,
          "text": "差不多就是买了票按时等着出发"
