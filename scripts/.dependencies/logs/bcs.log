        {
          "player": "稳健老陈",
          "seat": 4,
          "text": "出发前先确认一趟趟次和对应的位置"
        },
        {
          "player": "和事佬阿和",
          "seat": 5,
          "text": "先换好登机牌再找位置等着就行"
        }
      ]
    },
    {
      "round": 5,
      "speeches": [
