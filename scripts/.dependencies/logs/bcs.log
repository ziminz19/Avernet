2026-08-28 17:49:58  INFO bcs_ws::bot::dispatcher: 📥 [BCS] 收到 Bot 事件 (解析失败) bot_id=谁是卧底主持人 event=agent payload=Some(Object {"bcs_group_id": String("bcs_grp_93f794ecec4146f9993405d42056c8e0:7f3bb2c2"), "data": Object {"itemId": String("tool:call_ae4171ec522d4ba98e2df0d9"), "kind": String("tool"), "meta": String("from ~/Desktop/Avernet/.standalone-openclaw/workspaces/undercover-referee/skills/bcs-coordination/SKILL.md"), "name": String("read"), "phase": String("start"), "startedAt": Number(1787910598426), "status": String("running"), "title": String("read from ~/Desktop/Avernet/.standalone-openclaw/workspaces/undercover-referee/skills/bcs-coordination/SKILL.md"), "toolCallId": String("call_ae4171ec522d4ba98e2df0d9")}, "run_id": String("smnode-sm-4f18590a-b153-4a71-a4f9-e2e7be9b6b50-tally-0"), "stream": String("item"), "ts": Number(1787910598431)})
