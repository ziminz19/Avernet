  "game": "谁是卧底",
  "history": [
    {
      "round": 1,
      "speeches": [
        {
          "player": "戏精阿浪",
          "seat": 1,
          "text": "我跟你讲没它真出不了远门"
        },
        {
          "player": "逻辑控林工",
          "seat": 2,
          "text": "一年去不了几回，地方挺大的"
        },
        {
          "player": "你",
          "seat": 3,
          "text": "每次放假都要去这儿"
        },
        {
          "player": "稳健老陈",
          "seat": 4,
          "text": "去的时候一般都不太想多待"
        },
        {
          "player": "和事佬阿和",
          "seat": 5,
          "text": "基本就是出远门的时候才会去"
        },
        {
          "player": "话痨小满",
          "seat": 6,
          "text": "出来的时候整个人都松了"
        }
      ]
    },
    {
      "round": 2,
      "speeches": [
        {
          "player": "戏精阿浪",
          "seat": 1,
          "text": "就这么说吧一到节假日那根本走不动"
        },
        {
          "player": "逻辑控林工",
          "seat": 2,
          "text": "每次去都得提前好长时间出发"
        },
        {
          "player": "你",
          "seat": 3,
          "text": "每次都得等好久"
        },
        {
          "player": "稳健老陈",
          "seat": 4,
          "text": "进去之前总要先找地方停下"
        },
        {
          "player": "和事佬阿和",
          "seat": 5,
          "text": "人多的时候真的要预留好长时间"
        }
      ]
    },
    {
      "round": 3,
      "speeches": [
        {
          "player": "戏精阿浪",
          "seat": 1,
          "text": "说真的买了票就剩一件事干等"
        },
        {
          "player": "逻辑控林工",
          "seat": 2,
          "text": "进去之后先过一道安检，然后就在大厅等着叫号"
