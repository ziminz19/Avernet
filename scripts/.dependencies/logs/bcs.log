2026-08-31 17:18:17  INFO bcs_ws::bot::dispatcher: 📥 [BCS] 收到 Bot 事件 (解析失败) bot_id=谁是卧底主持人 event=agent payload=Some(Object {"bcs_group_id": String("bcs_grp_6634eeaef9384f60a8295974e495c2c6:78aa6308"), "data": Object {"itemId": String("tool:fc-13c5f052-4bdf-4091-bd69-1826be5b5cea"), "kind": String("tool"), "meta": String("from ~/Desktop/Avernet/.standalone-openclaw/workspaces/undercover-referee/skills/undercover-game-referee/references/boards.md"), "name": String("read"), "phase": String("start"), "startedAt": Number(1788167897439), "status": String("running"), "title": String("read from ~/Desktop/Avernet/.standalone-openclaw/workspaces/undercover-referee/skills/undercover-game-referee/references/boards.md"), "toolCallId": String("fc-13c5f052-4bdf-4091-bd69-1826be5b5cea")}, "run_id": String("373e6e01-2b92-4db8-9760-bb319de65823"), "stream": String("item"), "ts": Number(1788167897440)})
