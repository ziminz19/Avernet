2026-08-31 10:25:17  INFO bcs_ws::bot::dispatcher: 📥 [BCS] 收到 Bot 事件 (解析失败) bot_id=谁是卧底主持人 event=agent payload=Some(Object {"bcs_group_id": String("bcs_grp_3df262e9bded41a58c2657e57c861773:ca262f22"), "data": Object {"itemId": String("tool:fc-20177e20-4668-49b0-b8ae-82d5d64db3ac"), "kind": String("tool"), "meta": String("from ~/Desktop/Avernet/.standalone-openclaw/workspaces/undercover-referee/skills/undercover-game-referee/references/boards.md"), "name": String("read"), "phase": String("start"), "startedAt": Number(1788143117727), "status": String("running"), "title": String("read from ~/Desktop/Avernet/.standalone-openclaw/workspaces/undercover-referee/skills/undercover-game-referee/references/boards.md"), "toolCallId": String("fc-20177e20-4668-49b0-b8ae-82d5d64db3ac")}, "run_id": String("d1639b69-d109-44d5-8918-7e75a6cf067e"), "stream": String("item"), "ts": Number(1788143117728)})
