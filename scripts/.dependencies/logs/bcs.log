        {
          "player": "你",
          "seat": 3,
          "text": "能快速的到很远的地方"
        },
        {
          "player": "稳健老陈",
          "seat": 4,
          "text": "拿着票找到对应的那条通道就行"
        },
        {
          "player": "和事佬阿和",
          "seat": 5,
          "text": "差不多就是买了票按时等着出发"
        }
      ]
